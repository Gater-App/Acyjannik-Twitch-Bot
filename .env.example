# Kopiere diese Datei nach .env. Niemals echte Tokens committen.

# Live-Betrieb
TEST_MODE=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=yannick
TWITCH_BOT_LOGIN=
# Optional: werden bei fehlenden Werten automatisch per Helix ermittelt.
TWITCH_BROADCASTER_USER_ID=
TWITCH_BOT_USER_ID=

# OAuth Authorization Code Flow
TWITCH_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
OAUTH_HOST=127.0.0.1
OAUTH_PORT=3000
OAUTH_STATE_TTL_SECONDS=600
OAUTH_SCOPES=user:read:chat user:write:chat

# Token können zunächst hier gesetzt werden. Der Refresh-Token wird nach dem OAuth-Flow
# sicher in TOKEN_FILE gespeichert (Dateirechte 0600) und bei Rotation ersetzt.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TOKEN_FILE=data/oauth-tokens.json

# Laufzeit und Daten
DATABASE_PATH=data/halloween.sqlite
HALLOWEEN_ACTIVE_ON_START=false
AUTHORIZED_MODERATOR_IDS=

# Spielregeln
HALLOWEEN_COOLDOWN_MINUTES=15
EVENT_WEIGHTS_JSON={"TREAT":48,"TRICK":25,"JACKPOT":5,"GHOST":8,"WITCH":8,"EMPTY_HOUSE":5,"GOLDEN_PUMPKIN":1}
TREAT_MIN=5
TREAT_MAX=20
TRICK_MIN=1
TRICK_MAX=10
JACKPOT_MIN=25
JACKPOT_MAX=50
GHOST_MIN=1
GHOST_MAX=10
WITCH_MIN=10
WITCH_MAX=25
GOLDEN_PUMPKIN_MIN=50
GOLDEN_PUMPKIN_MAX=100

# Nachrichten und Limits
MAX_CHAT_MESSAGE_LENGTH=500
APP_CHAT_MESSAGE_LENGTH=450
SEND_QUEUE_INTERVAL_MS=1500
TEXTS_JSON={"treat":"🎃 {name} bekommt {points} Kürbisse!","trick":"👻 {name} verliert {points} Kürbisse!","jackpot":"💰 JACKPOT! {name} gewinnt {points} Kürbisse!","ghost":"👻 Ein Geist erschreckt {name}: -{points} Kürbisse!","witch":"🧙 Die Hexe segnet {name}: +{points} Kürbisse!","emptyHouse":"🏚️ {name} findet ein leeres Haus.","goldenPumpkin":"✨ GOLDENER KÜRBIS! {name} erhält {points} Kürbisse!"}
