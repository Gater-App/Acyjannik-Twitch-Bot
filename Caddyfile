{$BOT_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
	}

	@health path /health
	handle @health {
		reverse_proxy halloween-bot:3001
	}

	@oauth path /oauth/*
	handle @oauth {
		reverse_proxy halloween-bot:3000
	}

	@dashboard path /dashboard*
	handle @dashboard {
		reverse_proxy halloween-bot:3001
	}

	@community path /community /community/*
	handle @community {
		reverse_proxy halloween-bot:3001
	}

	@help path /hilfe
	handle @help {
		reverse_proxy halloween-bot:3001
	}

	@streamer path /streamer
	handle @streamer {
		reverse_proxy halloween-bot:3001
	}

	@widgets path /widgets/*
	handle @widgets {
		reverse_proxy halloween-bot:3001
	}

	@games path /games/*
	handle @games {
		reverse_proxy halloween-bot:3001
	}

	respond "Not found" 404
}
